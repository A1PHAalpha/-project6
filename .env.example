# LLM API 配置（示例以通义千问 OpenAI 兼容接口为例，DeepSeek 同理替换 BASE_URL/MODEL）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Embedding 模型（本地 fastembed 模型名）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 可选：把模型缓存固定到仓库外目录，避免下载到默认缓存
# FASTEMBED_CACHE_PATH=/path/to/model_cache

# 设备账号（请勿提交真实凭据到仓库，仅本地 .env 使用）
DEVICE_USERNAME=admin
DEVICE_PASSWORD=change_me
SNMP_COMMUNITY=public_ro
# 老 Cisco 设备兼容（放开 ssh-rsa 主机密钥算法），默认 false
SSH_LEGACY_ALGOS=false

# 远程网络接入（ZeroTier + EVE-NG 管理网），按你的实验环境填写
ZEROTIER_NETWORK_ID=
EVE_MGMT_IP=
EVE_MGMT_ROUTE_CIDR=
# connect_remote_network.py 连通性测试用的目标设备
DEVICE_TEST_HOST=
DEVICE_TEST_TYPE=cisco_ios

# Web 服务
APP_HOST=127.0.0.1
APP_PORT=8000
# 单口令 Token 鉴权（必填，长度 >= 16，否则应用拒绝启动）
APP_API_TOKEN=change_me_to_a_long_random_token
# 是否开放 /docs /redoc /openapi.json，默认关闭
APP_ENABLE_DOCS=false
# 热重载，仅开发时开启
APP_RELOAD=false

# 数据存储路径
SQLITE_DB_PATH=./data/ops.db
CHROMA_DB_PATH=./data/chroma
